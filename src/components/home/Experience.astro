---
import { getCollection } from 'astro:content';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/consts';

// Newest first. ("Nov 2024" → Date)
const startOf = (s: string) => new Date(`1 ${s}`).getTime();
const jobs = (await getCollection('jobs')).sort(
  (a, b) => startOf(b.data.start) - startOf(a.data.start),
);
---

<section id="experience" class="container-page py-28" aria-labelledby="experience-title">
  <SectionHeading
    id="experience-title"
    eyebrow="Experience"
    title="From Android apps to <em>AI systems</em>."
  >
    <a href={SITE.resume} class="btn-ghost shrink-0">
      Full résumé <Icon name="arrow-right" class="size-4" />
    </a>
  </SectionHeading>

  <ol class="border-b border-line">
    {jobs.map(({ data: j }) => (
      <li class="reveal grid gap-4 border-t border-line py-10 md:grid-cols-[12rem_1fr] md:gap-10">
        <div class="font-mono text-xs leading-relaxed text-muted">
          <p>
            {j.start} — {j.end}
          </p>
          <p>{j.location}</p>
        </div>
        <div>
          <h3 class="text-xl">
            {j.role},{' '}
            {j.url ? (
              <a href={j.url} target="_blank" rel="noopener" class="link">
                {j.company}
              </a>
            ) : (
              j.company
            )}
          </h3>
          <p class="mt-1 font-serif text-lg text-muted italic">{j.tagline}</p>
          <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">{j.summary}</p>
          <details class="group mt-4">
            <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-ink [&::-webkit-details-marker]:hidden">
              <span class="group-open:hidden">Show highlights</span>
              <span class="hidden group-open:inline">Hide highlights</span>
              <Icon
                name="arrow-right"
                class="size-3.5 rotate-90 transition-transform group-open:-rotate-90"
              />
            </summary>
            <ul class="mt-4 grid max-w-2xl gap-2 text-ink-soft">
              {j.highlights.map((h) => (
                <li class="flex gap-3">
                  <span class="mt-[0.7em] h-px w-3 shrink-0 bg-muted" aria-hidden="true" />
                  {h}
                </li>
              ))}
            </ul>
          </details>
        </div>
      </li>
    ))}
  </ol>
</section>
