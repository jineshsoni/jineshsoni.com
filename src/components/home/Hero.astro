---
import { Image } from 'astro:assets';
import Icon from '@/components/Icon.astro';
import { SITE, CAREER_START, yearsSince } from '@/consts';
import me from '@/assets/me.jpg';
import readable from '@/assets/work/readable-english/shot1.jpg';
import bijak from '@/assets/work/bijak/shot5.jpg';
import wandergier from '@/assets/work/wandergier/shot1.jpg';

const years = yearsSince(CAREER_START);

const identity = [
  { title: 'AI architecture', detail: 'On-device models · pipelines' },
  { title: 'AI in production', detail: 'Offline speech recognition' },
  { title: 'Mobile foundation', detail: `${years} yrs · 600K+ downloads` },
];

const phones = [
  {
    src: bijak,
    alt: 'Bijak agri-trading app',
    href: '/work/bijak/',
    cls: '-rotate-6 translate-y-6 -mr-8 z-10',
  },
  {
    src: readable,
    alt: 'Readable English reading tutor app',
    href: '/work/readable-english/',
    cls: 'z-20',
  },
  {
    src: wandergier,
    alt: 'Wandergier social travel app',
    href: '/work/wandergier/',
    cls: 'rotate-6 translate-y-6 -ml-8 z-10',
  },
];
---

<section class="pt-32 pb-20 sm:pt-40 lg:pb-28">
  <div class="container-page grid items-center gap-16 lg:grid-cols-[1.35fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <Image
          src={me}
          alt=""
          width={44}
          height={44}
          densities={[1, 2]}
          class="size-11 rounded-full object-cover"
          loading="eager"
        />
        <p class="text-sm leading-tight text-muted">
          <span class="font-medium text-ink">{SITE.name}</span>
          <br />
          Principal Developer at{' '}
          <a href={SITE.company.url} target="_blank" rel="noopener" class="link">
            {SITE.company.name}
          </a>
        </p>
      </div>

      <h1 class="mt-10 text-[clamp(3.2rem,8vw,6.25rem)] leading-[0.95]">
        Software that works <em>after the demo</em>.
      </h1>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-soft">
        Plenty of AI looks great on stage. I take it the last mile — onto phones, into classrooms
        with patchy Wi-Fi, into apps people use every day. {years} years of shipping mobile products
        taught me what production really means; now I architect the AI that runs inside them.
      </p>

      <dl class="mt-10 grid max-w-2xl border-y border-line sm:grid-cols-3 sm:border-b-0">
        {identity.map((item, i) => (
          <div
            class:list={[
              'flex items-baseline justify-between gap-4 py-3 sm:block sm:py-4',
              i > 0 && 'border-t border-line sm:border-t-0 sm:border-l sm:pl-5',
            ]}
          >
            <dt class="font-medium">{item.title}</dt>
            <dd class="text-sm text-muted sm:mt-1">{item.detail}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/#ai" class="btn-primary">
          See the AI work <Icon name="arrow-right" class="size-4" />
        </a>
        <a href={SITE.resume} class="link text-sm font-medium">
          Read résumé
        </a>
      </div>
    </div>

    <div
      class="relative mx-auto flex w-full max-w-sm items-center justify-center lg:max-w-none"
      aria-label="Apps I’ve built"
    >
      {phones.map((p, i) => (
        <a
          href={p.href}
          class:list={[
            'relative w-1/3 min-w-0 transition-transform duration-500 ease-out-expo hover:z-30 hover:-translate-y-2',
            p.cls,
          ]}
        >
          <div class="overflow-hidden rounded-[1.4rem] border-[5px] border-ink bg-ink shadow-[0_24px_50px_-24px_rgb(0_0_0/0.45)] sm:rounded-[1.8rem] sm:border-[6px]">
            <Image
              src={p.src}
              alt={p.alt}
              widths={[240, 360, 480]}
              sizes="(min-width: 1024px) 190px, 30vw"
              class="aspect-[9/19] w-full object-cover object-top"
              loading={i === 1 ? 'eager' : 'lazy'}
              fetchpriority={i === 1 ? 'high' : 'auto'}
            />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
