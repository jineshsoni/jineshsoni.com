---
import SectionHeading from '@/components/SectionHeading.astro';
import { SKILLS } from '@/data/skills';
---

<section id="skills" class="container-page py-28" aria-labelledby="skills-title">
  <SectionHeading id="skills-title" eyebrow="Toolbox" title="The stack I <em>reach for</em>." />
  <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {SKILLS.map((g) => (
      <div class="reveal border-t border-line pt-5">
        <h3 class="text-sm font-semibold">{g.title}</h3>
        <p class="mt-3 leading-relaxed text-ink-soft">{g.items.join(' · ')}</p>
      </div>
    ))}
  </div>
</section>
