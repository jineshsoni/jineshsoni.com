---
import SectionHeading from '@/components/SectionHeading.astro';
import { PRINCIPLES } from '@/data/principles';
---

<section id="principles" class="container-page py-28" aria-labelledby="principles-title">
  <SectionHeading
    id="principles-title"
    eyebrow="How I work"
    title="A few things I’ve learned <em>the hard way</em>."
  />
  <ol class="grid gap-x-16 gap-y-12 md:grid-cols-2">
    {PRINCIPLES.map((p, i) => (
      <li class="reveal border-t border-line pt-6">
        <p class="font-mono text-xs text-muted">{String(i + 1).padStart(2, '0')}</p>
        <h3 class="mt-3 font-serif text-3xl leading-tight font-normal tracking-normal">
          {p.title}
        </h3>
        <p class="mt-3 leading-relaxed text-ink-soft">{p.body}</p>
      </li>
    ))}
  </ol>
</section>
